{
  "name": "speedy",
  "vendor": "vtex",
  "version": "0.5.1",
  "title": "Speedy",
  "description": "Speedy is a VTEX IO app that improves the performance of your store by optimizing the loading of third-party scripts, prefetching data. It will allow you to improve the TBT and INP metrics",
  "scripts": {
    "postreleasy": "npm run build && git add . && git commit -m 'build' && git push && vtex publish --verbose"
  },
  "billingOptions": {
    "type": "free",
    "support": {
      "url": "https://support.vtex.com/hc/requests"
    },
    "availableCountries": [
      "*"
    ]
  },
  "builders": {
    "pixel": "0.x",
    "docs": "0.x"
  },
  "dependencies": {
    "vtex.pixel-interfaces": "1.x",
    "vtex.pixel-server": "0.x",
    "vtex.pixel-server-ui": "0.x"
  },
  "policies": [
    {
      "name": "pixel"
    }
  ],
  "settingsSchema": {
    "title": "VTEX Speedy",
    "type": "object",
    "bindingBounded": true,
    "properties": {
      "timeToPush3rdParty": {
        "title": "Time in seconds to push the 3rd party",
        "description": "Time in seconds ex: 5s (default is 10s)",
        "type": "string"
      },
      "block3rdParty": {
        "title": "Block all 3rd party",
        "description": "Block all 3rd party",
        "type": "boolean"
      },
      "customTimeToPush": {
        "title": "[CUSTOM] - List of 3rd party to push",
        "description": "Pattern: domain,seconds;domain,seconds;",
        "type": "string",
        "default": "googletagmanager,0;"
      },
      "preconnect": {
        "title": "[PRECONNECT] - List of domains to preconnect",
        "description": "Pattern: domain;domain;domain...",
        "type": "string",
        "default": "www.googletagmanager.com;fonts.googleapis.com;fonts.gstatic.com"
      },
      "blacklist": {
        "title": "[BLACKLIST] - List of domains to block",
        "description": "Pattern: domain;domain;domain...",
        "type": "string"
      },
      "prefetchAnchors": {
        "title": "Prefetch Anchors",
        "description": "Block all 3rd party",
        "type": "boolean",
        "default": true
      },
      "queueDelay": {
        "title": "Queue Delay",
        "description": "Delay in seconds to load each item of the queue",
        "type": "string",
        "default": "1.5"
      },
      "prefetchRule": {
        "title": "Prefetch Anchors Rule",
        "description": "Put the classNames anchors that should be prefetched separated by comma (You can add manually 'speedy')",
        "type": "string",
        "default": "product-summary"
      }
    }
  },
  "$schema": "https://raw.githubusercontent.com/vtex/node-vtex-api/master/gen/manifest.schema"
}
